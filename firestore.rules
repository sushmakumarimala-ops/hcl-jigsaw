rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidBookmark(data) {
      return data.keys().hasAll(['id', 'userId', 'claim', 'verdict', 'explanation', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'claim', 'verdict', 'explanation', 'createdAt', 'source']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.claim is string && data.claim.size() > 0 && data.claim.size() <= 500 &&
        data.verdict is string && data.verdict.size() <= 50 &&
        data.explanation is string && data.explanation.size() <= 1000 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('source' in data) || (data.source is string && data.source.size() <= 300));
    }

    function isValidReportedClaim(data) {
      return data.keys().hasAll(['id', 'claim', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'claim', 'status', 'createdAt', 'userId', 'userEmail']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.claim is string && data.claim.size() > 0 && data.claim.size() <= 500 &&
        data.status is string && data.status.size() <= 50 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 256));
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming()) && incoming().id == userId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Bookmarked myths and facts subcollection
      match /bookmarks/{bookmarkId} {
        allow get: if isOwner(userId) && isValidId(bookmarkId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(bookmarkId) &&
          isValidBookmark(incoming()) && incoming().userId == userId && incoming().id == bookmarkId;
        allow update: if isOwner(userId) && isValidId(bookmarkId) &&
          isValidBookmark(incoming()) && incoming().userId == userId &&
          incoming().id == existing().id && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(bookmarkId);
      }
    }

    // Reported unverified health claims submitted by users
    match /reportedClaims/{reportId} {
      allow create: if isValidId(reportId) && isValidReportedClaim(incoming()) && incoming().id == reportId;
      allow get: if isSignedIn() && isValidId(reportId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
